# Horode Proof - Environment Configuration Template
# Copy this file to .env.local for local development.
# Do NOT commit .env or secrets to source control.

# Application Identity (Public)
NEXT_PUBLIC_APP_NAME=Horode Proof

# Supabase Shared Project Configuration
# Connects to your existing Supabase project. All app data lives strictly in the 'horode_proof' schema.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder

# Privileged Server-Only Key
# NEVER expose this key in client-side code or public bundles.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

# Data Retention
DEFAULT_RETENTION_DAYS=30
